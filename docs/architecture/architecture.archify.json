  "cards": [
    {
      "dot": "emerald",
      "title": "Offline",
      "items": [
        "No online APIs, no cloud, no CDN",
        "Only OpenCV, NumPy, scikit-image on CPU",
        "Test photos are checked in memory, not saved"
      ]
    },
    {
      "dot": "cyan",
      "title": "Decision per part",
      "items": [
        "score = 0.5 x (1 - SSIM) + 0.5 x colour change",
        "Missing if score > 0.35",
        "Warning if alignment fails"
      ]
    },
    {
      "dot": "violet",
      "title": "Code layout",
      "items": [
        "core/ has no Flask code",
        "Can be tested without a browser (tools/)"
      ]
    }
  ]
